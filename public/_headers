/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://bible.helloao.org https://cloudflareinsights.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Always check for a new version of the app shell and service worker.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

/icon*
  Cache-Control: public, max-age=604800

/og.jpg
  Cache-Control: public, max-age=86400

# Bible text: whole public-domain testaments that rarely change (rebuilt by scripts/build-bible.mjs).
/bible/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
